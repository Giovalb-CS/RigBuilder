{
  "expo": {
    "name": "RigBuilder",
    "slug": "RigBuilder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/RigBuilder_Logo_OS.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/RigBuilder_Logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/RigBuilder_Logo.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/RigBuilder_site_watermark.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "API_URL": "http://192.168.1.9:8081/RigBuilder_webapp_project_war_exploded/api",
      "API_KEY": "ApiKeyProva123"
    }
  }
}
