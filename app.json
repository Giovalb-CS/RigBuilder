{
  "expo": {
    "name": "RigBuilder",
    "slug": "RigBuilder",
    "version": "1.0.0",
    "package": "com.rigbuilder.app",
    "orientation": "default",
    "icon": "./assets/images/RigBuilder_Logo_OS.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/RigBuilder_Logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "navigationBarColor": "#252525",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/RigBuilder_Logo_OS.png",
        "backgroundColor": "#000000"
      },
      "softwareKeyboardLayoutMode": "pan",
      "configChanges": [
        "keyboard",
        "keyboardHidden",
        "orientation",
        "screenSize",
        "keyboard",
        "keyboardHidden",
        "orientation",
        "screenSize"
      ],
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.MANAGE_EXTERNAL_STORAGE",
        "android.permission.MEDIA_LIBRARY",
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE"
      ],
      "networkSecurityConfig": "./network_security_config.xml",
      "icon": "./assets/images/RigBuilder_Logo_OS.png",
      "package": "com.rigbuilder.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/RigBuilder_site_watermark.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow RigBuilder to save files to your device.",
          "savePhotosPermission": "Allow RigBuilder to save files to your device."
        }
      ],
      ["expo-build-properties", {
        "android": {
          "usesCleartextTraffic": true
        }
      }]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "API_URL": "http://192.168.1.9:8080/RigBuilder_webapp_project_war_exploded/api",
      "API_KEY": "1P9N112129",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "ae32a14e-dfea-49f7-952a-90dde27a4428"
      }
    }
  }
}
